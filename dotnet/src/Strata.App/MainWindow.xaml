<Window x:Class="Strata.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strata"
        Width="1600"
        Height="980"
        MinWidth="1024"
        MinHeight="640"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource FgBrush}"
        WindowStartupLocation="CenterScreen"
        StateChanged="OnStateChanged"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Strata"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="56"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1"
                       Text="Host stub — privacy / screen-security shell. Feature UI lands in later migration phases."
                       FontSize="16"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,32"/>

            <StackPanel Grid.Row="2" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Screen security" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <CheckBox x:Name="HideForSharingCheck"
                          Content="Hidden for sharing (exclude from screen capture)"
                          Margin="0,0,0,8"
                          Checked="OnSettingChanged"
                          Unchecked="OnSettingChanged"/>
                <TextBlock Text="Window stays visible on your display; omitted from Snipping Tool, Teams, Zoom, OBS, Recall."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,20"
                           FontSize="12"/>

                <TextBlock Text="System tray" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <CheckBox x:Name="MinimizeToTrayCheck"
                          Content="Minimize / close to system tray"
                          Margin="0,0,0,12"
                          Checked="OnSettingChanged"
                          Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="StartInTrayCheck"
                          Content="Start hidden in the tray"
                          Margin="0,0,0,12"
                          Checked="OnSettingChanged"
                          Unchecked="OnSettingChanged"/>
                <CheckBox x:Name="HideFromTaskbarCheck"
                          Content="No taskbar button (Windows)"
                          Margin="0,0,0,8"
                          Checked="OnSettingChanged"
                          Unchecked="OnSettingChanged"/>
                <TextBlock Text="Hides the window, never the process (Task Manager still lists Strata)."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,20"
                           FontSize="12"/>

                <TextBlock Text="Research browser privacy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <CheckBox x:Name="BrowserBlurMediaCheck"
                          Content="Blur media in research browser"
                          Margin="0,0,0,8"
                          Checked="OnSettingChanged"
                          Unchecked="OnSettingChanged"/>
                <StackPanel Orientation="Horizontal" Margin="24,0,0,4">
                    <TextBlock x:Name="BlurAmountLabel"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Slider x:Name="BrowserBlurAmountSlider"
                            Width="200"
                            Minimum="1"
                            Maximum="100"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="OnBlurAmountChanged"/>
                </StackPanel>
                <TextBlock Text="Persisted now; live blur + Ctrl+Shift+X apply when the research pane ships (later phase)."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="24,0,0,12"
                           FontSize="12"/>
            </StackPanel>

            <TextBlock Grid.Row="3"
                       x:Name="StatusText"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,24,0,0"/>
        </Grid>
    </ScrollViewer>
</Window>
